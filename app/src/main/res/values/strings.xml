<?xml version="1.0" encoding="utf-8"?>
<!--
    ============================================================
    strings.xml - All App Strings in One Place
    ============================================================
    This file contains ALL text used in the app.

    ============================================================
    WHY USE strings.xml?
    ============================================================
    1. Easy to translate to other languages
    2. Consistent text across the app
    3. Easy to update text in one place
    4. No hardcoded text in layouts or code
    5. Follows Android best practices

    ============================================================
    HOW TO USE:
    ============================================================
    In XML layouts: android:text="@string/string_name"
    In Kotlin code: getString(R.string.string_name)

    ============================================================
    ORGANIZATION:
    ============================================================
    1. App Name & Dashboard
    2. Status Bar Messages
    3. Category Headers
    4. Tool Names
    5. Tool Descriptions
    6. Tool Icons (Emojis)
    7. Button Text
    8. Compass Strings
    9. GPS Location Strings
    10. Location Activity Status Messages
    11. Moon Phase Strings
    12. Sun Tracker Strings
    13. Speedometer Strings
    14. Distance Tracker Strings
    15. Altimeter Strings
    16. Metal Detector Strings
    17. EMF Meter Strings
    18. Gravity Meter Strings
    19. Bubble Level Strings
    20. Shake Detector Strings
    21. Space Ball Strings
    22. Trail Tracker Strings
    23. Star Finder Strings
    24. Geocaching Strings
-->


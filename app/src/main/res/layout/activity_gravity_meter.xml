<?xml version="1.0" encoding="utf-8"?>
<!--
    ============================================================
    activity_gravity_meter.xml - Gravity Meter Tool Layout
    ============================================================
    Features:
    - Dark theme (#1A1A2E)
    - Total force, X/Y/Z values, orientation
    - Reset: ORANGE
    - NO green checkboxes
-->

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#1A1A2E"
    tools:context=".motion.GravityMeterActivity">

    <!-- TOOLBAR -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/SensorToolBox.Toolbar"
        app:theme="@style/SensorToolBox.Toolbar"
        app:popupTheme="@style/SensorToolBox.PopupMenu"
        app:title="Gravity Meter"
        app:titleTextColor="#FFFFFF"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- SCROLLABLE CENTERED CONTAINER -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- TITLE -->
            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌐 Gravity Meter"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <!-- TOTAL FORCE CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#2A2A4E">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/totalForceText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="9.81 m/s²"
                        android:textSize="48sp"
                        android:textStyle="bold"
                        android:textColor="#4CAF50" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Gravitational Acceleration (g)"
                        android:textSize="13sp"
                        android:textColor="#AAAAAA"
                        android:layout_marginTop="4dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- AXIS CARD -->
            <androidx.cardview.widget.CardView
                android:id="@+id/axisCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#2A2A4E">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="X-Axis (Lateral)"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#AAAAAA"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/xAxisText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.00 m/s²"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="#F44336" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Y-Axis (Longitudinal)"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#AAAAAA"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/yAxisText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.00 m/s²"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="#4CAF50" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Z-Axis (Vertical)"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#AAAAAA"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/zAxisText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.00 m/s²"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="#2196F3" />

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ORIENTATION & REFERENCE -->
            <TextView
                android:id="@+id/orientationText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📱 Face Up"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/referenceText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌍 Earth's Standard Gravity: 9.80665 m/s² (1.0g)"
                android:textSize="13sp"
                android:textColor="#888888"
                android:layout_marginTop="4dp" />

            <!-- RESET - ORANGE -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/resetButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="160dp"
                android:text="🔄 Calibrate / Zero Baseline"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:singleLine="true"
                android:gravity="center"
                android:layout_marginTop="16dp"
                app:cornerRadius="10dp"
                app:backgroundTint="#FF9800"
                android:paddingStart="20dp"
                android:paddingEnd="20dp" />

            <!-- BASELINE -->
            <TextView
                android:id="@+id/baselineText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Baseline: --.-- m/s²"
                android:textSize="13sp"
                android:textColor="#888888"
                android:layout_marginTop="6dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
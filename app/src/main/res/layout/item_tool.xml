<?xml version="1.0" encoding="utf-8"?>
<!--
    ============================================================
    item_tool.xml - Tool Card Layout for RecyclerView
    ============================================================
    This is the LAYOUT for each individual tool card that appears
    in the dashboard grid.

    ============================================================
    FEATURES:
    ============================================================
    1. Fixed card height (150dp) - all cards same size
    2. Dark theme (#2A2A4E) matching other tools
    3. All OPEN buttons aligned at the same position
    4. Proper text sizes (11sp minimum for accessibility)
    5. Uses string resources (no hardcoded text)
-->

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toolCard"
    android:layout_width="match_parent"
    android:layout_height="150dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:layout_margin="4dp"
    app:cardBackgroundColor="#2A2A4E">

    <!-- ============================================================
         LINEAR LAYOUT - Arranges content vertically
         ============================================================ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp"
        android:gravity="center">

        <!-- ============================================================
             TOOL ICON - Emoji representing the tool
             ============================================================ -->
        <TextView
            android:id="@+id/toolIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="32sp"
            android:layout_gravity="center" />

        <!-- ============================================================
             TOOL TITLE - Name of the tool
             ============================================================ -->
        <TextView
            android:id="@+id/toolTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_gravity="center"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- ============================================================
             TOOL DESCRIPTION - Short description
             ============================================================ -->
        <TextView
            android:id="@+id/toolDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#888888"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- ============================================================
             TOOL BUTTON - OPEN or PLAY button
             ============================================================
             - Fixed height: 32dp (same for all)
             - Fixed minWidth: 70dp (same for all)
             - Uses @string/button_open (no hardcoded text)
             - Consistent color: Blue (#1A237E)
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/toolButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minWidth="70dp"
            android:text="@string/button_open"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:singleLine="true"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_marginTop="6dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:cornerRadius="8dp"
            app:backgroundTint="#1A237E" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
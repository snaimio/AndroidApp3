<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#1A1A2E"
    tools:context=".MapActivity">

    <!-- TOOLBAR -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/SensorToolBox.Toolbar"
        app:theme="@style/SensorToolBox.Toolbar"
        app:popupTheme="@style/SensorToolBox.PopupMenu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="🗺️ Map Location"
        app:titleTextColor="#FFFFFF" />

    <!-- MAPVIEW (FILLS SCREEN) -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toTopOf="@id/bottomInfoCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- FLOATING CONTROLS (BOTTOM RIGHT ABOVE BOTTOM CARD) -->
    <LinearLayout
        android:id="@+id/floatingControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/bottomInfoCard"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Layer Switcher FAB -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabLayer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:src="@android:drawable/ic_menu_agenda"
            android:contentDescription="Switch Map Layer"
            app:fabSize="mini"
            app:backgroundTint="#2A2A4E"
            app:tint="#FFFFFF" />

        <!-- My Location FAB (Recenter) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabMyLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_menu_mylocation"
            android:contentDescription="My Location"
            app:fabSize="normal"
            app:backgroundTint="@color/colorPrimary"
            app:tint="#FFFFFF" />

    </LinearLayout>

    <!-- TOP SEARCH BAR CARD -->
    <androidx.cardview.widget.CardView
        android:id="@+id/searchCard"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#2A2A4E"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍"
                android:textSize="16sp"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/searchEditText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Search destination address or city..."
                android:textColorHint="#888888"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:imeOptions="actionSearch"
                android:inputType="textPostalAddress"
                android:maxLines="1" />

            <ImageView
                android:id="@+id/btnClearSearch"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="4dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:contentDescription="Clear Search"
                android:visibility="gone"
                app:tint="#888888" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSearch"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Go"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                app:cornerRadius="18dp"
                app:backgroundTint="@color/colorPrimary"
                android:paddingHorizontal="14dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- LIVE NAVIGATION GUIDANCE HUD (Point A to Point B) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/navGuidanceCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:visibility="gone"
        app:cardCornerRadius="14dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#1A237E"
        app:layout_constraintTop_toBottomOf="@id/searchCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/navDistanceText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- km remaining"
                        android:textColor="#00E676"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/navBearingText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🧭 Head --°"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/navEtaText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⏱️ ETA: calculating..."
                        android:textColor="#FFD54F"
                        android:textSize="11sp" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStopNav"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="✕ Stop Nav"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="8dp"
                    app:backgroundTint="#F44336" />

            </LinearLayout>

            <TextView
                android:id="@+id/navTargetAddressText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Target: Destination"
                android:textColor="#E0E0E0"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- STATUS CHIP OVERLAY (WHEN NOT NAVIGATING) -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="@drawable/button_rounded"
        android:backgroundTint="#D91A1A2E"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:text="📍 Acquiring High-Precision GPS..."
        android:textColor="#E0E0E0"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end"
        app:layout_constraintTop_toBottomOf="@id/searchCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- BOTTOM INFO SHEET CARD -->
    <androidx.cardview.widget.CardView
        android:id="@+id/bottomInfoCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="10dp"
        app:cardBackgroundColor="#22223B"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Title & Address Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/cardTitleText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📍 Current Position"
                    android:textColor="#4CAF50"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/accuracyBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#1B5E20"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="GPS: ±3m"
                    android:textColor="#A5D6A7"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/cardAddressText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Resolving street address..."
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- Metrics Row (Speed, Altitude, Coordinates) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:background="#1A1A2E"
                android:padding="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SPEED"
                        android:textSize="10sp"
                        android:textColor="#888888" />

                    <TextView
                        android:id="@+id/cardSpeedText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0 km/h"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#2196F3" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:background="#333333" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ALTITUDE"
                        android:textSize="10sp"
                        android:textColor="#888888" />

                    <TextView
                        android:id="@+id/cardAltitudeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- m"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#FF9800" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:background="#333333" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="COORDINATES"
                        android:textSize="10sp"
                        android:textColor="#888888" />

                    <TextView
                        android:id="@+id/cardCoordinatesText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--.---, --.---"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#00E676" />
                </LinearLayout>

            </LinearLayout>

            <!-- Human-Centric Quick Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:gravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShareLocation"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="📤 Share"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="8dp"
                    app:backgroundTint="#3F51B5" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopyCoords"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="📋 Copy"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="8dp"
                    app:backgroundTint="#37474F" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNavigate"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:text="🧭 Navigate"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="8dp"
                    app:backgroundTint="#00897B" />

            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<!--
    ============================================================
    activity_altimeter.xml - Altimeter Tool Layout
    ============================================================
    Features:
    - Dark theme (#1A1A2E)
    - Current altitude, gain, loss, min, max
    - Start (GREEN), Stop (RED), Reset (ORANGE)
    - All strings from resources
-->

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#1A1A2E"
    tools:context=".speed.AltimeterActivity">

    <!-- TOOLBAR -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/SensorToolBox.Toolbar"
        app:theme="@style/SensorToolBox.Toolbar"
        app:popupTheme="@style/SensorToolBox.PopupMenu"
        app:title="@string/altimeter_title"
        app:titleTextColor="#FFFFFF"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- SCROLLABLE CENTERED CONTAINER -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <!-- TITLE -->
            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/altimeter_title"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <!-- ALTITUDE CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#2A2A4E">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/altitudeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/altimeter_altitude"
                        android:textSize="52sp"
                        android:textStyle="bold"
                        android:textColor="#4CAF50" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Current Elevation Above Sea Level"
                        android:textSize="13sp"
                        android:textColor="#AAAAAA"
                        android:layout_marginTop="4dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- STATS CARD -->
            <androidx.cardview.widget.CardView
                android:id="@+id/statsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#2A2A4E">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Row 1: Gain and Loss -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <!-- Gain -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/altimeter_gain"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="#AAAAAA" />

                            <TextView
                                android:id="@+id/gainText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/altimeter_value_m"
                                android:textSize="19sp"
                                android:textStyle="bold"
                                android:textColor="#4CAF50"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="40dp"
                            android:background="#444444" />

                        <!-- Loss -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/altimeter_loss"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="#AAAAAA" />

                            <TextView
                                android:id="@+id/lossText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/altimeter_value_m"
                                android:textSize="19sp"
                                android:textStyle="bold"
                                android:textColor="#F44336"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#444444"
                        android:layout_marginVertical="10dp" />

                    <!-- Row 2: Min and Max -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <!-- Min -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/altimeter_min"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="#AAAAAA" />

                            <TextView
                                android:id="@+id/minText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/altimeter_value_m"
                                android:textSize="19sp"
                                android:textStyle="bold"
                                android:textColor="#2196F3"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="40dp"
                            android:background="#444444" />

                        <!-- Max -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/altimeter_max"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="#AAAAAA" />

                            <TextView
                                android:id="@+id/maxText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/altimeter_value_m"
                                android:textSize="19sp"
                                android:textStyle="bold"
                                android:textColor="#FF9800"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- BUTTON CONTAINER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="20dp">

                <!-- START - GREEN -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/startButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/altimeter_start"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"
                    android:singleLine="true"
                    android:gravity="center"
                    android:layout_marginEnd="4dp"
                    app:cornerRadius="10dp"
                    app:backgroundTint="#4CAF50" />

                <!-- STOP - RED -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/stopButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/altimeter_stop"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"
                    android:singleLine="true"
                    android:gravity="center"
                    android:enabled="false"
                    android:layout_marginHorizontal="4dp"
                    app:cornerRadius="10dp"
                    app:backgroundTint="#F44336" />

                <!-- RESET - ORANGE -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/resetButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/altimeter_reset"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"
                    android:singleLine="true"
                    android:gravity="center"
                    android:enabled="false"
                    android:layout_marginHorizontal="4dp"
                    app:cornerRadius="10dp"
                    app:backgroundTint="#FF9800" />

                <!-- VIEW ON MAP - BLUE -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/viewMapButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="🗺️ Map"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"
                    android:singleLine="true"
                    android:gravity="center"
                    android:layout_marginStart="4dp"
                    app:cornerRadius="10dp"
                    app:backgroundTint="@color/colorPrimary" />

            </LinearLayout>

            <!-- STATUS -->
            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/altimeter_status_press_start"
                android:textSize="13sp"
                android:textColor="#888888"
                android:layout_marginTop="16dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
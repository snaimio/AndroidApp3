<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#1A1A2E"
    tools:context=".location.LocationActivity">

    <!-- TOOLBAR -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/SensorToolBox.Toolbar"
        app:theme="@style/SensorToolBox.Toolbar"
        app:popupTheme="@style/SensorToolBox.PopupMenu"
        app:title="@string/gps_location_title"
        app:titleTextColor="#FFFFFF"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- MAIN LOCATION METRICS CARD -->
    <androidx.cardview.widget.CardView
        android:id="@+id/locationCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#22223B"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Header with Accuracy Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📍 GPS Ready"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/accuracyText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#1B5E20"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:text="Accuracy: ±3m"
                    android:textColor="#A5D6A7"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Coordinates Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/gps_latitude"
                        android:textSize="10sp"
                        android:textColor="#888888" />

                    <TextView
                        android:id="@+id/latitudeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/gps_default_coordinate"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#4CAF50" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/gps_longitude"
                        android:textSize="10sp"
                        android:textColor="#888888" />

                    <TextView
                        android:id="@+id/longitudeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/gps_default_coordinate"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#4CAF50" />
                </LinearLayout>

            </LinearLayout>

            <!-- DMS & Altitude -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:background="#1A1A2E"
                android:padding="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.3"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DMS FORMAT"
                        android:textSize="9sp"
                        android:textColor="#888888" />

                    <TextView
                        android:id="@+id/dmsText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--° --&apos; --&quot; N, --° --&apos; --&quot; W"
                        android:textSize="11sp"
                        android:textColor="#E0E0E0" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:background="#333333" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.7"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/gps_altitude"
                        android:textSize="9sp"
                        android:textColor="#888888" />

                    <TextView
                        android:id="@+id/altitudeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/gps_default_altitude"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#FF9800" />
                </LinearLayout>

            </LinearLayout>

            <!-- Human Address Section -->
            <TextView
                android:id="@+id/addressText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/gps_getting_location"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:layout_marginTop="8dp"
                android:maxLines="2"
                android:ellipsize="end" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- INTERACTIVE OPENSTREETMAP PREVIEW CARD (Fills the center screen) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/mapPreviewCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="10dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#22223B"
        app:layout_constraintTop_toBottomOf="@id/locationCard"
        app:layout_constraintBottom_toTopOf="@id/actionsLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <org.osmdroid.views.MapView
                android:id="@+id/mapView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Open Full Map Overlay Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/viewMapButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_gravity="top|end"
                android:layout_margin="10dp"
                android:text="🗺️ Full Map"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                app:cornerRadius="16dp"
                app:backgroundTint="#D900897B" />

        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <!-- ACTION BUTTONS ROW -->
    <LinearLayout
        android:id="@+id/actionsLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Primary Refresh Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/getLocationButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="🔄 Refresh GPS Location"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            app:cornerRadius="10dp"
            app:backgroundTint="@color/colorPrimary" />

        <!-- Utility Buttons: Share, Copy, Navigate -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShareLocation"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="📤 Share"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                app:cornerRadius="8dp"
                app:backgroundTint="#3F51B5" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopyCoords"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:text="📋 Copy"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                app:cornerRadius="8dp"
                app:backgroundTint="#37474F" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavigate"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="🗺️ Open Map"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                app:cornerRadius="8dp"
                app:backgroundTint="#00897B" />

        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
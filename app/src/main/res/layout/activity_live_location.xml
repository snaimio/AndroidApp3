<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#1A1A2E"
    tools:context=".LiveLocationActivity">

    <!-- TOOLBAR -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/SensorToolBox.Toolbar"
        app:theme="@style/SensorToolBox.Toolbar"
        app:popupTheme="@style/SensorToolBox.PopupMenu"
        app:title="📡 Live Location"
        app:titleTextColor="#FFFFFF"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- DESTINATION SEARCH BAR -->
            <androidx.cardview.widget.CardView
                android:id="@+id/searchCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#22223B">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔍"
                        android:textSize="18sp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/etDestinationSearch"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="Search place or tap map to navigate..."
                        android:textColorHint="#777799"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:imeOptions="actionSearch"
                        android:inputType="textPostalAddress"
                        android:maxLines="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSearch"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="Go"
                        android:textSize="12sp"
                        android:textColor="#FFFFFF"
                        app:cornerRadius="8dp"
                        app:backgroundTint="@color/colorPrimary" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- TURN-BY-TURN NAVIGATION BANNER (Google Maps style, visible during navigation) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/navBannerCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#00695C">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvManeuverIcon"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:gravity="center"
                        android:text="⬆️"
                        android:textSize="26sp"
                        android:background="#33FFFFFF"
                        android:layout_marginEnd="12dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvNextTurnDistance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="In 200 m"
                            android:textColor="#80CBC4"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvManeuverInstruction"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Continue straight towards destination"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:maxLines="2" />

                        <TextView
                            android:id="@+id/tvNavEta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Remaining: -- km • ~-- min"
                            android:textColor="#E0F2F1"
                            android:textSize="11sp" />

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- EMBEDDED LIVE OPENSTREETMAP CARD -->
            <androidx.cardview.widget.CardView
                android:id="@+id/mapCard"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#22223B">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <org.osmdroid.views.MapView
                        android:id="@+id/miniMapView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <!-- Live GPS Precision Badge -->
                    <TextView
                        android:id="@+id/gpsStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="10dp"
                        android:background="#D91A1A2E"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="🟢 GPS Locked • ±--m"
                        android:textColor="#4CAF50"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <!-- Floating Map Controls -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:orientation="vertical"
                        android:layout_margin="10dp">

                        <com.google.android.material.floatingactionbutton.FloatingActionButton
                            android:id="@+id/fabLayer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:src="@android:drawable/ic_menu_agenda"
                            android:contentDescription="Switch Map Layer"
                            app:fabSize="mini"
                            app:backgroundTint="#2A2A4E"
                            app:tint="#FFFFFF" />

                        <com.google.android.material.floatingactionbutton.FloatingActionButton
                            android:id="@+id/fabFollowMe"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:src="@android:drawable/ic_menu_compass"
                            android:contentDescription="Follow Me Mode"
                            app:fabSize="mini"
                            app:backgroundTint="#00796B"
                            app:tint="#FFFFFF" />

                        <com.google.android.material.floatingactionbutton.FloatingActionButton
                            android:id="@+id/fabMyLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@android:drawable/ic_menu_mylocation"
                            android:contentDescription="My Location"
                            app:fabSize="mini"
                            app:backgroundTint="@color/colorPrimary"
                            app:tint="#FFFFFF" />

                    </LinearLayout>

                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- GENUINE GPS GEODETIC TELEMETRY (Dual Coordinates, Accuracy, Heading, Satellites) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/geodesyCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#22223B">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🌐 RAW GPS GEODETIC FIX"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#4CAF50" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCopyCoords"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="📋 Copy"
                            android:textSize="11sp"
                            android:textColor="#FFFFFF"
                            android:paddingHorizontal="8dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            app:cornerRadius="6dp"
                            app:backgroundTint="#3F51B5" />

                    </LinearLayout>

                    <!-- Coordinates (Decimal & DMS) -->
                    <TextView
                        android:id="@+id/tvDecimalCoords"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Decimal: --.------° N, ---.------° W"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDmsCoords"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="DMS: --° --&apos; --&quot; N, ---° --&apos; --&quot; W"
                        android:textColor="#BBBBCC"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#33334E"
                        android:layout_marginVertical="8dp" />

                    <!-- Geodetic Details Row: Accuracy, Heading, Fix Provider -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Accuracy -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ACCURACY RADIUS"
                                android:textColor="#8888AA"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvGpsAccuracy"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="±-- m"
                                android:textColor="#00E676"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Heading / Bearing -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="COURSE BEARING"
                                android:textColor="#8888AA"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvGpsBearing"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="---° --"
                                android:textColor="#FFB74D"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Fix Type / Satellites -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CONSTELLATION"
                                android:textColor="#8888AA"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvGpsProvider"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="3D GPS Fix"
                                android:textColor="#29B6F6"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- REVERSE GEOCODED ADDRESS CARD -->
            <androidx.cardview.widget.CardView
                android:id="@+id/addressCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#22223B">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📍 Current Street &amp; Region"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#8888AA" />

                    <TextView
                        android:id="@+id/addressText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Acquiring reverse geocoded address..."
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- NAVIGATION & LOCATION ACTION BUTTONS -->
            <LinearLayout
                android:id="@+id/buttonBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNavigateAction"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1.4"
                    android:layout_marginEnd="6dp"
                    android:text="🧭 Start Navigation"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="8dp"
                    app:backgroundTint="#00897B" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShareGps"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:text="📤 Share GPS"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="8dp"
                    app:backgroundTint="#3F51B5" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<!--
    ============================================================
    activity_emf_meter.xml - EMF Meter Tool Layout
    ============================================================
    Features:
    - Dark theme (#1A1A2E)
    - EMF value, bar, status, safety info
    - Reset: ORANGE
    - NO green checkboxes
-->

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#1A1A2E"
    tools:context=".detection.EMFMeterActivity">

    <!-- TOOLBAR -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/SensorToolBox.Toolbar"
        app:theme="@style/SensorToolBox.Toolbar"
        app:popupTheme="@style/SensorToolBox.PopupMenu"
        app:title="EMF Meter"
        app:titleTextColor="#FFFFFF"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- TITLE -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📡 EMF Meter"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- EMF VALUE -->
    <TextView
        android:id="@+id/emfValueText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0.00 µT"
        android:textSize="48sp"
        android:textStyle="bold"
        android:textColor="#4CAF50"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/titleText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- EMF BAR -->
    <View
        android:id="@+id/emfBar"
        android:layout_width="0dp"
        android:layout_height="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:background="#4CAF50"
        app:layout_constraintTop_toBottomOf="@id/emfValueText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- STATUS -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✅ Safe - Low EMF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#4CAF50"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/emfBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- SAFETY INFO -->
    <TextView
        android:id="@+id/safetyInfoText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📱 Typical background level"
        android:textSize="14sp"
        android:textColor="#888888"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/statusText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- BUTTONS CONTAINER -->
    <LinearLayout
        android:id="@+id/buttonContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/safetyInfoText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/resetButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="90dp"
            android:text="🔄 Reset"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:singleLine="true"
            android:gravity="center"
            android:layout_marginEnd="6dp"
            app:cornerRadius="10dp"
            app:backgroundTint="#FF9800"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveHotspotButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="90dp"
            android:text="📍 Log Spot"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:singleLine="true"
            android:gravity="center"
            android:layout_marginEnd="6dp"
            app:cornerRadius="10dp"
            app:backgroundTint="#F44336"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/viewMapButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="90dp"
            android:text="🗺️ Map Spots"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:singleLine="true"
            android:gravity="center"
            app:cornerRadius="10dp"
            app:backgroundTint="@color/colorPrimary"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>